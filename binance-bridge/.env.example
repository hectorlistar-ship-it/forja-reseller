# Binance Bridge Environment Variables
# Copy to .env and fill in (never commit .env)

# Bridge authentication (generate random 32-char string)
BRIDGE_TOKEN=your_bridge_token_here_32_chars_min

# Worker callback URL (your Cloudflare Worker)
WORKER_CALLBACK_URL=https://reseller.tudominio.workers.dev/api/binance/callback

# Gmail credentials for IMAP (app password works for IMAP)
GMAIL_USER=tu_email@gmail.com
GMAIL_APP_PASSWORD=tu_app_password_gmail

# Polling interval in milliseconds (default 120000 = 2 min)
POLL_INTERVAL_MS=120000

# Optional: MongoDB for persistent logs
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/binance-bridge

# Bridge port (Render assigns this automatically)
PORT=3456